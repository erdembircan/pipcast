{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@pipcast/contract": ["./plugin/src/contract/index.ts"]
    }
  },
  "include": ["plugin/src/contract", "plugin/src/core", "test/contract", "test/plugin"]
}
