{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@pipcast/contract": ["./packages/contract/src/index.ts"],
      "@pipcast/director": ["./packages/director/src/index.ts"],
      "@pipcast/design": ["./design/components/index.d.ts"]
    }
  },
  "include": ["packages/contract/src", "packages/director/src", "packages/director/test", "packages/dev/src", "packages/dev/test", "packages/renderer/src", "packages/renderer/test"]
}
